{
    "name": "cataloging/catalog",
    "description": "Cataloging component",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Oleksandr Tishchenko / Marketing America Corp",
            "email": "17111337+taa0662621456@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^3.3",
        "symfony/dependency-injection": "^7.1",
        "symfony/doctrine-bridge": "^7.1",
        "symfony/framework-bundle": "^7.1",
        "symfony/http-client": "^7.1",
        "symfony/http-foundation": "^7.1",
        "symfony/messenger": "^7.1",
        "symfony/monolog-bundle": "^3.10",
        "symfony/routing": "^7.1",
        "symfony/runtime": "^7.1",
        "symfony/security-bundle": "^7.1",
        "symfony/serializer-pack": "^1.0",
        "symfony/twig-bundle": "^7.1",
        "symfony/yaml": "^7.1"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.6",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "tools/php/php84.bat tools/qa/CatalogPhpLint.php",

        "cs:fix": "tools/php/php84.bat vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
        "cs:check": "tools/php/php84.bat vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "cs:check-quiet": "tools/php/php84.bat vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run",

        "stan": "@stan:conservative",
        "stan:conservative": "tools/php/php82.bat vendor/bin/phpstan analyse",
        "stan:runtime-target": "tools/php/php84.bat vendor/bin/phpstan analyse",

        "md": "tools/php/php84.bat vendor/bin/phpmd src,text phpmd.xml.dist",
        "md:tests": "tools/php/php84.bat vendor/bin/phpmd tests,text phpmd.xml.dist",

        "test": "tools/php/php84.bat vendor/bin/phpunit -c phpunit.xml.dist",
        "test:unit": "tools/php/php84.bat vendor/bin/phpunit -c phpunit.xml.dist --testsuite unit",
        "test:integration": "tools/php/php84.bat vendor/bin/phpunit -c phpunit.xml.dist --testsuite integration",
        "test:e2e": "tools/php/php84.bat vendor/bin/phpunit -c phpunit.xml.dist --testsuite e2e",

        "qa:style": [
            "@lint",
            "@cs:check"
        ],
        "qa:static": [
            "@stan"
        ],
        "qa:smell": [
            "@md",
            "@md:tests"
        ],
        "qa:test": [
            "@test"
        ],
        "qa:full": [
            "@qa:style",
            "@qa:static",
            "@qa:smell",
            "@qa:test"
        ],

        "smoke:runtime": "tools/php/php84.bat tools/smoke/category-runtime-smoke.php",
        "smoke:fixtures": "tools/php/php84.bat tools/smoke/category-fixture-sanity.php",
        "smoke:container": "tools/php/php84.bat tools/smoke/category-container-boot-smoke.php",
        "smoke:doctrine": "tools/php/php84.bat tools/smoke/category-doctrine-mapping-smoke.php",
        "smoke:fixture-load": "tools/php/php84.bat tools/smoke/category-fixture-load-smoke.php",
        "smoke:graphql": "tools/php/php84.bat tools/smoke/category-graphql-smoke.php",

        "report:owner-overlap": "tools/php/php84.bat tools/inspection/CatalogOwnerOverlapReport.php",
        "report:route-inventory": "tools/php/php84.bat tools/inspection/CatalogRouteInventoryReport.php",
        "report:class-alias": "tools/php/php84.bat tools/inspection/CatalogClassAliasReport.php",
        "report:runtime-proof": "tools/php/php84.bat tools/inspection/CatalogRuntimeProofReport.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
