{% extends 'base.html.twig' %}
{% block body %}
<h1>{{ category ? 'Edit' : 'New' }} category</h1>
<form method="post">
  <label>Name <input type="text" name="name" value="{{ category.name ?? '' }}"></label><br>
  <label>Slug <input type="text" name="slug" value="{{ category.slug ?? '' }}"></label><br>
  <button type="submit">Save</button>
</form>
{% endblock %}
