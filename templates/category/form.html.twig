{% extends 'base.html.twig' %}

{% block body %}
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h1 class="h4 mb-0">{{ is_edit ? 'Edit category' : 'Create category' }}</h1>
                    </div>
                    <div class="card-body">
                        {{ form_start(form, {attr: {class: 'row g-3'}}) }}
                        <div class="col-12">
                            {{ form_label(form.name, null, {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(form.name) }}
                            {{ form_errors(form.name) }}
                        </div>
                        <div class="col-12">
                            {{ form_label(form.slug, null, {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(form.slug) }}
                            {{ form_errors(form.slug) }}
                        </div>
                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <a href="{{ path('admin_category_index') }}" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
